{
    "manifests": {
        "shopwell/docker": {
            "manifest": {
                "copy-from-recipe": {
                    "docker/": "docker/",
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  * <fg=blue>Setup</>",
                    "    This recipe has created a <comment>docker/Dockerfile</comment> with an example file to build a Shopwell Docker image.",
                    "    You can build it with <comment>docker build -t <name> -f docker/Dockerfile .</comment>.",
                    "    Make sure you to set a correct `APP_SECRET`, you can generate one with `openssl rand -hex 128`",
                    "    See https://github.com/shopwell-shop/docker for the complete documentation to configure things."
                ]
            },
            "files": {
                "config/packages/prod/monolog.yaml": {
                    "contents": [
                        "parameters:",
                        "  env(MONOLOG_LOG_LEVEL): \"error\"",
                        "monolog:",
                        "    handlers:",
                        "        main:",
                        "            type: fingers_crossed",
                        "            action_level: \"%env(MONOLOG_LOG_LEVEL)%\"",
                        "            handler: nested",
                        "            excluded_http_codes: [404, 405]",
                        "            buffer_size: 50",
                        "        nested:",
                        "            type: stream",
                        "            path: php://stderr",
                        "            level: \"%env(MONOLOG_LOG_LEVEL)%\"",
                        "            formatter: monolog.formatter.json",
                        "        console:",
                        "            type: console",
                        "            process_psr_3_messages: false",
                        "            channels: [\"!event\", \"!doctrine\"]",
                        "        business_event_handler_buffer:",
                        "            level: \"%env(MONOLOG_LOG_LEVEL)%\"",
                        ""
                    ],
                    "executable": false
                },
                "docker/Dockerfile": {
                    "contents": [
                        "#syntax=docker/dockerfile:1.4",
                        "",
                        "# pin versions",
                        "FROM ghcr.io/shopwell-shop/docker-base:8.4 AS base-image",
                        "FROM ghcr.io/shopwell-shop/shopwell-cli:latest-php-8.3 AS shopwell-cli",
                        "",
                        "# build",
                        "",
                        "FROM shopwell-cli AS build",
                        "",
                        "ARG SHOPWELL_PACKAGES_TOKEN",
                        "",
                        "ADD . /src",
                        "WORKDIR /src",
                        "",
                        "ENV SHOPWELL_CACHE_ID=docker",
                        "",
                        "RUN --mount=type=secret,id=composer_auth,dst=/src/auth.json \\",
                        "    --mount=type=cache,target=/root/.composer \\",
                        "    --mount=type=cache,target=/root/.npm \\",
                        "    /usr/local/bin/entrypoint.sh shopwell-cli project ci /src",
                        "",
                        "# build final image",
                        "",
                        "FROM base-image",
                        "",
                        "ENV SHOPWELL_DISABLE_UPDATE_CHECK=1",
                        "",
                        "COPY --from=build --chown=82 --link /src /var/www/html",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "de1727c6cb328d3abcde2e39a826ea9ed65404b8"
        }
    }
}
